{
  "name": "cispoly-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prebuild-data": "node scripts/build-data.ts",
    "dev": "node scripts/dev-watch.mjs",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint src scripts react-router.config.ts vite.config.ts",
    "check:content": "node scripts/verify-content.mjs",
    "check:build": "node scripts/verify-build.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:content",
    "build": "node scripts/build-data.ts && react-router typegen && tsc -b && react-router build && node scripts/verify-build.mjs",
    "preview": "vite preview --outDir build/client"
  },
  "dependencies": {
    "framer-motion": "^11.3.24",
    "isbot": "^5",
    "lucide-react": "^0.427.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "react-router": "^8.3.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.4.41",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
